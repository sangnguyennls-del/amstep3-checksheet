# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase local
supabase/.temp
supabase/.branches
supabase/seed.sql

# claude worktrees / subagent-driven-development scratch
.claude/worktrees/
.superpowers/

# typescript
*.tsbuildinfo
next-env.d.ts

# Pha 7 data migration: file xlsx nguồn thật + báo cáo/temp export không commit
*.xlsx
scripts/migrate/*.log
scripts/migrate/tmp/

# Pha 8 audit export/purge: file export .ndjson.gz có thể chứa dữ liệu thật
# (tên/MSNV người dùng) — không commit vào git.
scripts/audit/tmp/

# Dữ liệu prod xuất ra (KHÔNG commit)
data-export/

# Google service account key JSON (SECRET — không bao giờ commit; giá trị nằm ở .env.local)
*-service-account*.json
gcp-*.json
am-step-3-project-*.json
